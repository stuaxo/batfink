{
  "name": "batfink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Amstrad CPC 464 dev environment: Z80 emulator, assembler and playground",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/batfink/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:conformance": "vitest run -c vitest.integration.config.ts conformance",
    "test:differential": "vitest run -c vitest.integration.config.ts differential",
    "typecheck:integration": "tsc -p test/integration/tsconfig.json --noEmit",
    "fetch:fixtures": "node scripts/fetch-fixtures.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "happy-dom": "^20.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.2",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "codemirror": "^6.0.2",
    "lz-string": "^1.5.0"
  }
}
